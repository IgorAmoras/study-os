{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "allowJs": true, "checkJs": false, "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "esModuleInterop": true
  },
  "include": ["src/**/*.tsx"]
}
